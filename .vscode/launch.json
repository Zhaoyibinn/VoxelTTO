                "--use_training_resolution_crop",
                "--align_gt_camera",
                "--config_file", "configs/inference.yaml",
                "--checkpoint_path", "logs/vgvggt_spunet_iggt_224x448/ckpts/checkpoint.pt",
                "--sparse_subdir", "test"
            ]
        }
    ]
}
